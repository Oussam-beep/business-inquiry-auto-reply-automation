    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 700, system: 'You are ' + $json.sender_name + ', the owner of ' + $json.business_name + ', personally replying to an inbound lead. Write in the FIRST person (I/we) — never refer to ' + $json.sender_name + ' in the third person. Tone: warm, brief, professional, no hype, no emojis. Goal: get the lead to book a call at this exact link: ' + $json.booking_url + ' — mention it once, naturally, in the body. Do NOT add any sign-off, name or signature at the end — a signature is appended automatically after your last sentence. Respond with ONLY minified JSON, no markdown fences: {\"subject\":\"<email subject>\",\"body\":\"<plain-text email body>\"}', messages: [{ role: 'user', content: 'Lead name: ' + $json.name + '\\nLead message: ' + $json.message + '\\nQualification summary: ' + $json.summary + '\\nCategory: ' + $json.category }] }) }}",
        "options": {}
      },
      "id": "draft-reply-claude",
      "name": "Draft Reply (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        -100
      ],
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's reply JSON (with fallback) and merge everything\nconst res = $input.first().json;\nlet text = res.content?.[0]?.text ?? '';\ntext = text.trim().replace(/^```(json)?/i, '').replace(/```$/, '').trim();\nlet r;\ntry { r = JSON.parse(text); }\ncatch (e) { r = { subject: 'Thanks for reaching out', body: text }; }\nconst lead = $('Parse Qualification').first().json;\nreturn [{ json: { ...lead, reply_subject: r.subject, reply_body: r.body } }];"
      },
